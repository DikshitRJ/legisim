# ==============================================================================
# LegiSim Backend Environment Configuration
# Copy this file to .env and adjust variables as needed for local development.
# ==============================================================================

# Core Settings
ENVIRONMENT=development
SECRET_KEY=change-me-in-production-legisim-secure-key-12345
DOMAIN=localhost

# PostgreSQL 16 + pgvector Connection URL (Asyncpg)
DATABASE_URL=postgresql+asyncpg://legisim:legisim_db_pass@localhost:5432/legisim

# Redis Cache and Pub/Sub
REDIS_URL=redis://localhost:6379/0

# MinIO / S3 Object Storage
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=minio_admin_pass
S3_BUCKET_NAME=legisim-data
S3_USE_SSL=false

# Authentication / JWT Configuration
JWT_SECRET_KEY=jwt-secret-change-me-in-production-random-token
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# AI Services
ZAI_API_KEY=
SEARXNG_URL=http://localhost:8080
JEV_SERVICE_URL=http://localhost:8001/predict

# Observability (Langfuse Tracing & GlitchTip Error Tracking)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
GLITCHTIP_DSN=
