# ==============================================================================
# LegiSim Environment Variables (Example)
# ==============================================================================
# Copy this file to .env and fill in your keys.
# Note: Service routing, database URLs, and ports are automatically handled 
# by docker-compose and do not need to be specified here.

# ------------------------------------------------------------------------------
# Core Security
# ------------------------------------------------------------------------------
# Secret keys for JWT and sessions. Generate random strings for production.
SECRET_KEY=legisim-secret-key-change-me-in-production-12345
JWT_SECRET_KEY=legisim-jwt-secret-key-replace-in-production-token

# ------------------------------------------------------------------------------
# AI Services & API Keys
# ------------------------------------------------------------------------------
# Z.ai API Key (used by LangGraph nodes for GLM-4)
ZAI_API_KEY=

# OpenAI API Key (fallback for LangChain standard models)
OPENAI_API_KEY=

# TypeSafeAI JEV API Key (used for targeting and filtering)
TYPESAFEAI_API_KEY=

# ------------------------------------------------------------------------------
# Observability (Optional)
# ------------------------------------------------------------------------------
GLITCHTIP_DSN=
