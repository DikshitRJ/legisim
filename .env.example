# ==============================================================================
# LegiSim Docker Infrastructure Environment Configuration (.env.example)
# Copy this file to .env before starting Docker Compose:
#   cp .env.example .env
# ==============================================================================

# Core Application Settings
ENVIRONMENT=development
DOMAIN=localhost
SECRET_KEY=legisim-secret-key-change-me-in-production-12345

# Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_USER=legisim
POSTGRES_PASSWORD=legisim_db_pass
POSTGRES_DB=legisim
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://legisim:legisim_db_pass@postgres:5432/legisim

# Redis Cache and Pub/Sub
REDIS_PASSWORD=redis_secure_pass
REDIS_PORT=6379
REDIS_URL=redis://:redis_secure_pass@redis:6379/0

# MinIO S3 Object Storage
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=minio_admin_pass
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=minio_admin_pass
S3_BUCKET_NAME=legisim-data
S3_USE_SSL=false

# Authentication & JWT Configuration
JWT_SECRET_KEY=legisim-jwt-secret-key-replace-in-production-token
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# AI & Search Services
ZAI_API_KEY=
SEARXNG_URL=http://searxng:8080
JEV_SERVICE_URL=http://langgraph-engine:8001/predict

# Observability (Optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3002
GLITCHTIP_DSN=

# Service Ports
BACKEND_PORT=8000
LANGGRAPH_PORT=8001
ZAI_PROXY_PORT=8002
SEARXNG_PORT=8080
FRONTEND_PORT=3000
ADMIN_PORT=3001
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8088
